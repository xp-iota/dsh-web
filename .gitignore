# dsh-web 独立工程的忽略规则（自成一体，不依赖任何上层仓库的 .gitignore）
#
# 依赖
node_modules/

# 构建产物
dist/
*.tsbuildinfo

# 本地运行产生的会话数据（会话日志、SQLite 索引）。
# 生产环境这个目录挂成卷，容器里的路径是 /data。
.dsh-home/

# 临时目录
tmp/

# 密钥：只走环境变量，不进版本库。
.env
.env.*
!.env.example

# 日志
*.log
npm-debug.log*

# 编辑器与系统文件
.vscode/
.idea/
.DS_Store
Thumbs.db
