{
  "name": "dsh-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "基于 @deepseek-ai/dsh 0.2.1-rc.2 的智能体 Web 服务：HTTP+SSE 自建薄层 + React/Vite 前端 + Node/Bun 双运行时 + 只读对话模式。",
  "engines": {
    "node": ">=22.18",
    "bun": ">=1.4.4"
  },
  "scripts": {
    "//runtimes": "双运行时：Node 与 Bun 都验证过（npm run verify）。所有命令经 runtime/run.mjs 调度，默认 node；:bun 变体走 Bun，DSH_RUNTIME=bun 可改默认值。",
    "//start": "启动 Web 服务（默认 8787 端口）。DSH_RUNTIME=bun npm start 即以 Bun 运行。",
    "start": "node runtime/run.mjs src/server/main.ts",
    "start:bun": "node runtime/run.mjs --runtime bun src/server/main.ts",
    "//dev": "开发模式：后端起服务，前端 Vite 热更新（前端 5173，后端 8787，代理 /api）。",
    "dev": "node runtime/run.mjs src/server/main.ts",
    "dev:web": "npm --prefix web run dev",
    "//build": "构建前端产物到 web/dist（Docker build 阶段用）。",
    "build": "npm --prefix web run build",
    "//test": "对真实 SDK 与装配树的冒烟测试；需要真实 provider 的用例在缺 LLM_API_KEY 时 skip。",
    "test": "node runtime/run.mjs --test",
    "test:bun": "node runtime/run.mjs --runtime bun --test",
    "//typecheck": "把全部源码直接编译到真实包自带的 .d.ts 上。",
    "typecheck": "node runtime/run.mjs --typecheck",
    "typecheck:bun": "node runtime/run.mjs --runtime bun --typecheck",
    "//runtime": "运行时层自身的工具：状态盘点、双运行时并排校验。",
    "runtime:status": "node runtime/status.mjs",
    "//verify": "两套运行时各跑 typecheck / test / 启动探针，末行打印 RUNTIMES_VERIFY_OK。",
    "verify": "node runtime/verify.mjs",
    "//docker": "构建生产镜像（内含 Node 与 Bun 两套运行时，DSH_RUNTIME 决定用哪个）。",
    "docker:build": "docker build -t dsh-web:latest ."
  },
  "//dependencies": "只读对话模式的依赖子集：不含任何 fs/bash/subprocess/workflow 包，因此 Bun 侧不需要 dsh-lab 的两个 preload shim。",
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/cordis-plugin-timer": "1.1.7",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.2",
    "@deepseek-ai/dsh-agent-default-model": "0.2.1-rc.2",
    "@deepseek-ai/dsh-agent-loop": "0.2.1-rc.2",
    "@deepseek-ai/dsh-app-boot": "0.2.1-rc.2",
    "@deepseek-ai/dsh-authorization": "0.2.1-rc.2",
    "@deepseek-ai/dsh-commands": "0.2.1-rc.2",
    "@deepseek-ai/dsh-command-feedback": "0.2.1-rc.2",
    "@deepseek-ai/dsh-compaction-basic": "0.2.1-rc.2",
    "@deepseek-ai/dsh-compaction-image-offload": "0.2.1-rc.2",
    "@deepseek-ai/dsh-compaction-tool-result-pruner": "0.2.1-rc.2",
    "@deepseek-ai/dsh-credentials-local": "0.2.1-rc.2",
    "@deepseek-ai/dsh-deepseek-llm-api-extensions": "0.2.1-rc.2",
    "@deepseek-ai/dsh-invariants": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm-deepseek-api-key": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm-retry": "0.2.1-rc.2",
    "@deepseek-ai/dsh-message-feedback": "0.2.1-rc.2",
    "@deepseek-ai/dsh-permission-presets": "0.2.1-rc.2",
    "@deepseek-ai/dsh-plan-mode": "0.2.1-rc.2",
    "@deepseek-ai/dsh-repeat-tool-reminder": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session-checkpoint-policy": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session-log-deepseek": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session-projection": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session-projection-cache": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session-query": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session-query-sqlite": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session-reference": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session-stats": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session-title": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session-title-first-prompt-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session-turn-outline": "0.2.1-rc.2",
    "@deepseek-ai/dsh-spill-local": "0.2.1-rc.2",
    "@deepseek-ai/dsh-spill-policy": "0.2.1-rc.2",
    "@deepseek-ai/dsh-storage": "0.2.1-rc.2",
    "@deepseek-ai/dsh-storage-domain": "0.2.1-rc.2",
    "@deepseek-ai/dsh-storage-json": "0.2.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.2",
    "@deepseek-ai/dsh-timeout": "0.2.1-rc.2",
    "@deepseek-ai/dsh-token-meter": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tool-ask-user": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tool-call-timeout-policy": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tool-skill": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tool-todo": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tool-web": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@deepseek-ai/dsh-user-approval": "0.2.1-rc.2",
    "@deepseek-ai/dsh-user-questions": "0.2.1-rc.2",
    "@deepseek-ai/dsh-web": "0.2.1-rc.2",
    "@deepseek-ai/dsh-web-deepseek-api": "0.2.1-rc.2",
    "@deepseek-ai/dsh-web-fetch-http": "0.2.1-rc.2",
    "@deepseek-ai/dsh-web-search-deepseek": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "3.18.5"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "typescript": "5.9.3"
  }
}
