# dsh-web 的环境变量样例
#
# 复制成 .env 后填写：`cp .env.example .env`
#
# ⚠️ .env 里是密钥，不要提交进版本库（.gitignore 已包含 .env）。
# compose 会自动读同目录的 .env。

# ── 模型路由（必填）────────────────────────────────────────────────
# Anthropic 兼容网关的基地址（不含 /v1/messages）。
LLM_BASE_URL=http://your-gateway.example.com

# 模型 id。要与网关实际支持的模型名完全一致。
LLM_MODEL=your-model-id

# 网关密钥。
LLM_API_KEY=sk-xxxxxxxx

# 路由名，必须与 cordis.patch.yml 里注册的路由一致。
# anthropic-compat = 本工程移植的兼容适配器；deepseek-official = 官方原生路由。
DSH_MODEL_PROVIDER=anthropic-compat

# vendor 决定请求头与端点细节：fuyao | minimax | 留空。
LLM_VENDOR=

# 可选：DeepSeek 原生路由与 web 搜索用的 key。留空则只走上面的兼容路由。
DEEPSEEK_API_KEY=

# ── 运行时 ─────────────────────────────────────────────────────────
# node | bun。改这个之后要重启容器才生效。
DSH_RUNTIME=node

# ── 端口 ───────────────────────────────────────────────────────────
# 宿主机端口。容器内固定 8787。
DSH_WEB_PORT=8787
